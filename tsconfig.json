{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "compilerOptions": {
    /* Base */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],

    /* Output - build artifacts go to dist */
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* Type checking only - no emit for typecheck script */
    "noEmit": true,

    /* Allow .ts extensions in imports (pi ecosystem convention) */
    "allowImportingTsExtensions": true,

    /* Strictness - relaxed for pi extension compatibility */
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    /* Modules */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,

    /* Skip lib check (peer deps) */
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
